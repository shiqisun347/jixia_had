# Single Linux host, existing HTTPS proxy, no Redis/Ingress/Egress.
# Private API-key map is a separate root-owned 0600 YAML file, never committed.
port: 7880
bind_addresses:
  - 0.0.0.0
key_file: /etc/livekit-keys.yaml
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true
logging:
  level: info
turn:
  enabled: false
