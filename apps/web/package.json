{
  "name": "@jx/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev": "node ../../scripts/web-dev.mjs",
    "build": "node ../../scripts/build-web.mjs",
    "start": "next start",
    "storybook": "storybook dev --port 6006 --no-open",
    "build:storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts --project=storybook",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node ../../scripts/run-playwright.mjs test",
    "ui:check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build:storybook && corepack pnpm test:storybook && corepack pnpm test:browser && corepack pnpm build"
  },
  "dependencies": {
    "@hookform/resolvers": "5.7.1",
    "@jx/contracts": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.43.0",
    "livekit-client": "2.21.0",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-vitest": "10.5.5",
    "@storybook/nextjs-vite": "10.5.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "27.0.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "1.62.1",
    "postcss": "8.5.25",
    "shadcn": "4.16.1",
    "storybook": "10.5.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
