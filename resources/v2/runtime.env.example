# Public v2.0 deployment baseline. Supply secrets privately; never commit real values.
# The model resource bundle references JX_LLM_API_KEY during import only.
APP_ENV=production
LOG_LEVEL=INFO
CORE_HOST=127.0.0.1
CORE_PORT=8100
CORS_ORIGINS=https://debate.example.com
ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
TTS_MODEL=qwen-audio-3.1-tts-flash
ASR_WS_URL=wss://llm-88h5fmsp127fpced.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
TTS_WS_URL=wss://llm-88h5fmsp127fpced.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
LLM_GLOBAL_CONCURRENCY=50
PROVIDER_CAPTURE_ENABLED=true
DIAGNOSTIC_QUEUE_SIZE=1024
DIAGNOSTIC_BATCH_SIZE=50
DIAGNOSTIC_FLUSH_INTERVAL_MS=250
# Absolute paths on the new host. Copy the reviewed bundle assets to this root.
# HOST_AUDIO_STORAGE_DIR is the parent of host-audio/, not host-audio/ itself.
HOST_AUDIO_STORAGE_DIR=/var/lib/jixia/resources
AVATAR_STORAGE_DIR=/var/lib/jixia/avatars
AGENT_AUDIO_STORAGE_DIR=/var/lib/jixia/agent-audio
MATCH_AUDIO_STORAGE_DIR=/var/lib/jixia/match-audio
EXPORT_STORAGE_DIR=/var/lib/jixia/exports
# Required private configuration (no defaults):
# DATABASE_URL=postgresql+psycopg://...
# LLM_KEY_ENCRYPTION_KEY=<32-byte key encoded as base64>
# ASR_API_KEY=<your authorized provider key>
# TTS_API_KEY=<your authorized provider key>
# LIVEKIT_URL=wss://rtc.example.com
# LIVEKIT_API_KEY=<your RTC key>
# LIVEKIT_API_SECRET=<your RTC secret>
