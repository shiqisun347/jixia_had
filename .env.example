# Public v2.0 development example. Keep real credentials in a private copy.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://jx:change-me@127.0.0.1:5432/jx_debate
# Integration tests must use a separate database and never the development URL.
TEST_DATABASE_URL=postgresql+psycopg://jx_test:change-me@127.0.0.1:5432/jx_debate_test
CORE_HOST=127.0.0.1
CORE_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
# Bounded PostgreSQL persistence for redacted WARNING/ERROR diagnostics.
DIAGNOSTIC_QUEUE_SIZE=1024
DIAGNOSTIC_BATCH_SIZE=50
DIAGNOSTIC_FLUSH_INTERVAL_MS=250
# Optional research capture writer; disabling preserves historical readers and export snapshots.
PROVIDER_CAPTURE_ENABLED=true
# Match the reviewed resource bundle; source-code ASR defaults are historical.
ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
TTS_MODEL=qwen-audio-3.1-tts-flash
ASR_WS_URL=wss://llm-88h5fmsp127fpced.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
TTS_WS_URL=wss://llm-88h5fmsp127fpced.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
HOST_AUDIO_STORAGE_DIR=./resources/v2/assets
# Supply authorized private ASR_API_KEY and TTS_API_KEY, plus the model encryption
# key and import-time JX_LLM_API_KEY as described in docs/v2-reproduction.md.
# LiveKit credentials are optional as a group for offline setup, required for RTC.
# LIVEKIT_URL=wss://rtc.example.com
# LIVEKIT_API_KEY=<your RTC key>
# LIVEKIT_API_SECRET=<your RTC secret>
